// `secrets.h` is listed in .gitignore - never commit it.

#pragma once

// Wi-Fi (2.4 GHz only - the ESP32 cannot join 5 GHz networks)
#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// Telegram bot (see README -> "Telegram setup")
#define BOT_TOKEN "123456789:replace-with-your-bot-token"
#define CHAT_ID "replace-with-your-chat-id"
